{
  "name": "opencode-berg-terminal",
  "version": "0.2.0",
  "description": "Source-first OpenCode TUI plugin and theme with a responsive Berg command center",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "oc-plugin": [
    "tui"
  ],
  "main": "./index.tsx",
  "bin": {
    "opencode-berg-terminal": "./scripts/install.mjs"
  },
  "exports": {
    ".": "./index.tsx",
    "./theme": "./themes/berg-terminal.json",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.tsx",
    "tui.tsx",
    "src",
    "assets",
    "benchmarks",
    "themes/berg-terminal.json",
    "examples/tui.json",
    "scripts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "benchmark": "node ./scripts/benchmark.mjs",
    "doctor": "node ./scripts/doctor.mjs",
    "install:check": "node ./scripts/install.mjs",
    "install:local": "node ./scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./src/*.test.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.15.4",
    "@opentui/core": "0.2.11",
    "@opentui/keymap": "0.2.11",
    "@opentui/solid": "0.2.11",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.4",
    "@opentui/core": "0.2.11",
    "@opentui/keymap": "0.2.11",
    "@opentui/solid": "0.2.11",
    "@types/node": "^26.4.1",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
