{
  "name": "opencode-berg-terminal",
  "version": "1.1.0",
  "description": "Bloomberg-style command center TUI plugin and theme for OpenCode: realtime agents, delegated executions, usage and quota",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "terminal",
    "bloomberg",
    "theme",
    "ai-agents",
    "opentui"
  ],
  "homepage": "https://github.com/afrizalyogi/opencode-berg-terminal#readme",
  "bugs": "https://github.com/afrizalyogi/opencode-berg-terminal/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afrizalyogi/opencode-berg-terminal.git"
  },
  "license": "MIT",
  "author": "Afrizal Yogi Pratama",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "oc-plugin": [
    "tui"
  ],
  "main": "./index.tsx",
  "bin": {
    "opencode-berg-terminal": "./scripts/install.mjs"
  },
  "exports": {
    ".": "./index.tsx",
    "./theme": "./themes/berg-terminal.json",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.tsx",
    "tui.tsx",
    "src",
    "!src/**/*.test.ts",
    "themes/berg-terminal.json",
    "examples/tui.json",
    "scripts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "benchmark": "node ./scripts/benchmark.mjs",
    "doctor": "node ./scripts/doctor.mjs",
    "install:check": "node ./scripts/install.mjs",
    "install:local": "node ./scripts/install.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test ./src/*.test.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.15.4",
    "@opentui/core": "0.2.11",
    "@opentui/keymap": "0.2.11",
    "@opentui/solid": "0.2.11",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.4",
    "@opentui/core": "0.2.11",
    "@opentui/keymap": "0.2.11",
    "@opentui/solid": "0.2.11",
    "@types/node": "^26.4.1",
    "solid-js": "1.9.12",
    "typescript": "5.8.2"
  }
}
