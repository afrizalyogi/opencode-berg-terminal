{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "void": "#000000",
    "panel": "#11161A",
    "element": "#1A2026",
    "orange": "#FB8B1E",
    "orangeDark": "#B85C00",
    "blue": "#0068FF",
    "blueText": "#0068FF",
    "mint": "#4AF6C3",
    "red": "#FF433D",
    "white": "#E8E8E8",
    "muted": "#888888",
    "border": "#283036"
  },
  "theme": {
    "primary": { "dark": "orange", "light": "orangeDark" },
    "secondary": { "dark": "blue", "light": "blue" },
    "accent": { "dark": "orange", "light": "orangeDark" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orangeDark" },
    "success": { "dark": "mint", "light": "#087D61" },
    "info": { "dark": "blueText", "light": "#0055CC" },
    "text": { "dark": "white", "light": "#17191B" },
    "textMuted": { "dark": "muted", "light": "#5E666C" },
    "background": { "dark": "void", "light": "#F4F1EB" },
    "backgroundPanel": { "dark": "panel", "light": "#EBE6DC" },
    "backgroundElement": { "dark": "element", "light": "#DED7CA" },
    "border": { "dark": "border", "light": "#AAA397" },
    "borderActive": { "dark": "orange", "light": "orangeDark" },
    "borderSubtle": { "dark": "#1C1C1C", "light": "#CBC4B7" },
    "diffAdded": { "dark": "mint", "light": "#087D61" },
    "diffRemoved": { "dark": "red", "light": "#B52C32" },
    "diffContext": { "dark": "muted", "light": "#697178" },
    "diffHunkHeader": { "dark": "blueText", "light": "#0055CC" },
    "diffHighlightAdded": { "dark": "mint", "light": "#087D61" },
    "diffHighlightRemoved": { "dark": "red", "light": "#B52C32" },
    "diffAddedBg": { "dark": "void", "light": "#DCEEDD" },
    "diffRemovedBg": { "dark": "void", "light": "#F3DCDD" },
    "diffContextBg": { "dark": "panel", "light": "#EAE4D8" },
    "diffLineNumber": { "dark": "muted", "light": "#777066" },
    "diffAddedLineNumberBg": { "dark": "void", "light": "#CBE5CE" },
    "diffRemovedLineNumberBg": { "dark": "void", "light": "#EACBCD" },
    "markdownText": { "dark": "white", "light": "#17191B" },
    "markdownHeading": { "dark": "orange", "light": "orangeDark" },
    "markdownLink": { "dark": "blueText", "light": "#0055CC" },
    "markdownLinkText": { "dark": "blueText", "light": "#0055CC" },
    "markdownCode": { "dark": "mint", "light": "#087D61" },
    "markdownBlockQuote": { "dark": "muted", "light": "#5E666C" },
    "markdownEmph": { "dark": "blueText", "light": "#0055CC" },
    "markdownStrong": { "dark": "orange", "light": "orangeDark" },
    "markdownHorizontalRule": { "dark": "border", "light": "#AAA397" },
    "markdownListItem": { "dark": "orange", "light": "orangeDark" },
    "markdownListEnumeration": { "dark": "blueText", "light": "#0055CC" },
    "markdownImage": { "dark": "blueText", "light": "#0055CC" },
    "markdownImageText": { "dark": "blueText", "light": "#0055CC" },
    "markdownCodeBlock": { "dark": "white", "light": "#17191B" },
    "syntaxComment": { "dark": "muted", "light": "#697178" },
    "syntaxKeyword": { "dark": "orange", "light": "#A34F00" },
    "syntaxFunction": { "dark": "blueText", "light": "#0055CC" },
    "syntaxVariable": { "dark": "white", "light": "#17191B" },
    "syntaxString": { "dark": "mint", "light": "#087D61" },
    "syntaxNumber": { "dark": "blue", "light": "#0055CC" },
    "syntaxType": { "dark": "blueText", "light": "#0055CC" },
    "syntaxOperator": { "dark": "orange", "light": "#A34F00" },
    "syntaxPunctuation": { "dark": "white", "light": "#17191B" }
  }
}
